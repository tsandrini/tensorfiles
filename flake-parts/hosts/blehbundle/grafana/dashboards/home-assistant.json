    {
      "id": 8,
      "type": "state-timeline",
      "title": "Bulbs",
      "datasource": {
        "type": "prometheus",
        "uid": "vOqQHM-f7fecKnIgFdV4OnVuvHU6Pfbd"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 6
      },
      "description": "Tapo L530 on the IoT subnet. Brightness 0 = off; unavailable = no answer (the shower bulb is wall-switched).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vOqQHM-f7fecKnIgFdV4OnVuvHU6Pfbd"
          },
          "expr": "homeassistant_light_brightness_percent{job=\"home-assistant\"} or on(entity) (homeassistant_entity_available{job=\"home-assistant\",domain=\"light\"} - 1)",
          "legendFormat": "{{friendly_name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#5b5a57"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "unavailable",
                  "color": "#5b5a57",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "#2c2c2a",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 100,
                "result": {
                  "text": "on",
                  "color": "#c98500",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
